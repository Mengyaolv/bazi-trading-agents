# Bazi Trading Agents Configuration

# Public deployment: enable only behind an HTTPS proxy.
# PUBLIC_MODE=1
# Set a private, random token before the first administrator registers.
# INITIAL_ADMIN_TOKEN=

# LLM Provider Configuration
LLM_PROVIDER=siliconflow
LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_BASE_URL=https://api.siliconflow.cn/v1

# Alternative providers:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4
# LLM_BASE_URL=

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-opus-20240229
# LLM_BASE_URL=

# API Keys (if needed)
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# SILICONFLOW_API_KEY=your_siliconflow_api_key

# Analysis Configuration
MAX_DEBATE_ROUNDS=3
DEBUG=true
APP_TIMEZONE=Asia/Shanghai
MEMORY_MIN_QUALITY_SCORE=0.4
PROMPT_VERSION=phase2-prompt-v1
QUALITY_MIN_SCORE=70
QUALITY_REWRITE_ENABLED=false
QUALITY_LLM_JUDGE_ENABLED=false

# Memory Retrieval / Embedding Configuration
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=your_siliconflow_embedding_model
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings

# Directory Configuration
MEMORY_DIR=./memory
RESULTS_DIR=./results
